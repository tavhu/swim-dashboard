  @@id([serviceCenterId, serviceId])
}

// ───────────────────────────────────────────────────────────────────────────
// Reference taxonomies
//
// The manual's ការកំណត់* screens. Forms 2–6 (service use, case plan,
// reintegration, follow-up, closure) all select from these lists rather than
// storing free text, so they are the dependency for the rest of the
// case-management build. Client records currently keep this sort of thing as
// loose String columns, which is what these replace.
//
// Every entity carries Khmer and English names because the spec requires a
// language switcher; `code` is the ministry's លេខកូដ and is the stable handle
// for a row, so it is unique.
// ───────────────────────────────────────────────────────────────────────────

/// ប្រភេទអតិថិជន — the kind of person a case is about (orphan, juvenile in
/// conflict with the law, trafficking victim, and so on).
model ClientType {
  id String @id @default(cuid())
  /// លេខកូដ. Entered by hand when the ministry has an official code for the
  /// category; otherwise left out and the database fills it from a sequence,
  /// the same way Client_PersonalInformation.ReadableCode works. Doing it in
  /// the default rather than in the handler keeps it race-free without a
  /// read-then-write.
  code String @unique @default(dbgenerated("('CT'::text || lpad((nextval('client_type_code_seq'::regclass))::text, 3, '0'::text))"))
  nameKh         String // ឈ្មោះ (ខ្មែរ)
  nameEn         String? // ឈ្មោះ (អង់គ្លេស)
  description    String? // បរិយាយ
  isActive       Boolean         @default(true)
  clientServices ClientService[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("clientTypes")
}

/// ប្រភេទសេវាកម្ម — the category a service falls under. Distinct from
/// `Service`, which is a specific catalogued programme with its legal basis.
model ServiceType {
  id          String   @id @default(cuid())
  code        String   @unique // លេខកូដ
  nameKh      String // ឈ្មោះសេវា (ខ្មែរ)
  nameEn      String? // ឈ្មោះសេវា (អង់គ្លេស)
  description String? // បរិយាយ
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("serviceTypes")
}

/// ក្រុមសម្ភារៈ ឬឧបករណ៍ជំនួយ — assistive material and device groups.
model AssistiveGroup {
  id          String          @id @default(cuid())
  nameKh      String // ឈ្មោះសម្ភារៈ (ខ្មែរ)
  nameEn      String? // ឈ្មោះសម្ភារៈ (អង់គ្លេស)
  description String? // បរិយាយ
  isActive    Boolean         @default(true)
  types       AssistiveType[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("assistiveGroups")
}

/// ប្រភេទសម្ភារៈ ឬឧបករណ៍ជំនួយ
model AssistiveType {
  id          String            @id @default(cuid())
  code        String            @unique // លេខកូដ
  groupId     String // ក្រុម
  group       AssistiveGroup    @relation(fields: [groupId], references: [id])
  nameKh      String // ឈ្មោះ (ខ្មែរ)
  nameEn      String? // ឈ្មោះ (អង់គ្លេស)
  description String? // បរិយាយ
  isActive    Boolean           @default(true)
  items       AssistiveDevice[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([groupId])
  @@map("assistiveTypes")
}

/// សម្ភារៈ ឬឧបករណ៍ជំនួយ — the individual item that can be issued or repaired
/// for a client. Photo is stored the same way as elsewhere: a path under
/// `public/uploads`, written by server/utils/uploads.ts.
model AssistiveDevice {
  id          String        @id @default(cuid())
  code        String        @unique // លេខកូដ
  typeId      String // ប្រភេទសម្ភារៈ ឬឧបករណ៍ជំនួយ
  type        AssistiveType @relation(fields: [typeId], references: [id])
  photo       String? // រូបភាព
  nameKh      String // ឈ្មោះ (ខ្មែរ)
  nameEn      String? // ឈ្មោះ (អង់គ្លេស)
  description String? // បរិយាយ
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([typeId])
  @@map("assistiveDevices")
}

/// ទម្រង់ទី២ — ការប្រើសេវាកម្មរបស់អតិថិជន.
///
/// Section 1 of the paper form (client code, name, family phone) is not stored
/// again: it is read from the linked Client_PersonalInformation. A client can
/// have many of these, one per episode of service.
model ClientService {
  id       String                     @id @default(cuid())
  clientId String
  client   Client_PersonalInformation @relation(fields: [clientId], references: [id])

  // ២. ព័ត៌មានរោគឬសញ្ញាណវិនិច្ឆ័យ
  //
  // The manual repeats three questions from ទម្រង់ទី១ here — whether the client
  // has been in a centre before, which ones, and how many times. They are not
  // stored again: Client_PersonalInformation already holds UsedtoRehab,
  // HowManyTimeHaveServed and the ClientServeHistory rows, and a second copy
  // would only be able to disagree with the first.
  clientTypeId        String? // ប្រភេទអតិថិជន
  clientType          ClientType? @relation(fields: [clientTypeId], references: [id])
  reason              String? // មូលហេតុ
  attachments         String? // ឯកសារពាក់ព័ន្ធ — comma separated, as CenterPlan.filePath
  diagnosisApprovedBy String? // អនុម័តរោគវិនិច្ឆ័យដោយ
  conclusion          String? // សន្និដ្ឋាន

  // ៣. ព័ត៌មានសេវាកម្មដែលត្រូវការប្រើ
  //
  // The service comes from the catalogue maintained at /service — the one
  // carrying each programme's legal basis and eligibility.
  //
  // This section also used to carry three narrowing levels, ក្រុមស្តារនីតិសម្បទា
  // -> ប្រភេទស្តារនីតិសម្បទា -> សេវាកម្មស្តារនីតិសម្បទាលម្អិត. They were dropped
  // deliberately: the manual names only the first two levels and only for four
  // of the seven groups, so three groups dead-ended with an empty second
  // dropdown and the third level had no source of values at all. Bringing them
  // back means answering where the ministry's list and its codes come from.
  serviceDate DateTime? // ថ្ងៃខែឆ្នាំមកទទួលសេវាកម្ម
  serviceId   String? // សេវាកម្ម
  service     Service?  @relation("ClientServiceCatalogue", fields: [serviceId], references: [id])

  // ៤. អ្នកផ្តល់សេវា និងស្ថានភាពអតិថិជនបច្ចុប្បន្ន
  providerName      String? // ឈ្មោះស្ថាប័នផ្តល់សេវា
  providerLocation  String? // ទីតាំងផ្តល់សេវា
  providerAgent     String? // ឈ្មោះភ្នាក់ងារផ្តល់សេវា
  providerPhone     String? // លេខទំនាក់ទំនង
  currentStatus     String? // មិនល្អ / ប្រសើរ / ប្រក្រតីភាព
  followUpServiceId String? // តម្រូវការសេវាបន្ត
  followUpService   Service? @relation("ClientServiceFollowUp", fields: [followUpServiceId], references: [id])

  // ៥. សិទ្ធិអនុម័ត — same fields as Client_PersonalInformation so one approval
  // component serves every form.
  approvalStatus  ApprovalStatus @default(DRAFT)
  submittedAt     DateTime?
  submittedByID   String?
  decidedAt       DateTime?
  decidedByID     String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([approvalStatus])
  @@map("clientServices")
}
