generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
}

model User {
  id              String           @id @unique @default(cuid())
  firstname       String?
  lastname        String?
  username        String           @unique
  password        String
  image           String?
  status          Boolean          @default(true)
  userRoleID      String?
  serviceCenterID String?
  organisationID  String?
  accountType     AccountType      @default(USER)
  Organisation    Organisation?    @relation(fields: [organisationID], references: [id])
  ServiceCenter   ServiceCenter?   @relation(fields: [serviceCenterID], references: [id])
  Role            Role?            @relation(fields: [userRoleID], references: [id])
  contactMessage  contactMessage[]
  approvalEvents  ApprovalEvent[]
}

model contactMessage {
  id                String   @id @unique @default(cuid())
  email             String?
  name              String?
  phone             String?
  details           String?
  reason            String?
  serviceCenterName String?
  username          String?
  createdAt         DateTime @default(now())
  deleted           Boolean  @default(false)
  read              Boolean
  user              User[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  resource    RoleToResource[]
  users       User[]
}

model Resources {
  id          String           @id @default(cuid())
  name        String           @unique
  backEndURL  String?
  frontEndURL String?
  Role        RoleToResource[]
}

model RoleToResource {
  roleID     String
  resourceID String
  granted    Boolean   @default(false)
  read       Boolean   @default(false)
  Resource   Resources @relation(fields: [resourceID], references: [id])
  role       Role      @relation(fields: [roleID], references: [id])

  @@id([roleID, resourceID])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organisation {
  id          String          @id @default(cuid())
  name        String
  logo        String?
  website     String?
  email       String?
  phoneNumber String?
  address     String?
  users       User[]
  service     ServiceCenter[]
  parent      Organisation?   @relation("OrganisationToOrganisation", fields: [parentId], references: [id])
  children    Organisation[]  @relation("OrganisationToOrganisation")
  parentId    String?
  Staff       Staff[]
  governStaff governStaff[]
}

model ServiceCenter {
  id                         String                       @id @default(cuid())
  nameKH                     String
  nameEN                     String
  createdAt                  DateTime                     @default(now())
  logo                       String
  type                       String
  directorName               String
  phoneNumber                String
  PoBox                      String
  email                      String
  website                    String
  locationMap                String
  Address                    String?
  overview                   String?
  background                 String?
  mission                    String?
  vision                     String?
  goal                       String?
  ProjectSummary             String?
  status                     Boolean
  City                       String?
  District                   String?
  Commute                    String?
  Village                    String?
  organisationID             String?
  Organisation               Organisation?                @relation(fields: [organisationID], references: [id])
  Client_PersonalInformation Client_PersonalInformation[]
  staff                      Staff[]
  governStaff                governStaff[]
  systemUser                 User[]
  CenterPlan                 CenterPlan[]
  services                   ServicesOnServiceCenters[]
}

enum AccountType {
  USER
  ORGANISATION
}

