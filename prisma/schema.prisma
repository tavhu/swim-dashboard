generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
}

model User {
  id              String           @id @unique @default(cuid())
  firstname       String?
  lastname        String?
  username        String           @unique
  password        String
  image           String?
  status          Boolean          @default(true)
  userRoleID      String?
  serviceCenterID String?
  ServiceCenter   ServiceCenter?   @relation(fields: [serviceCenterID], references: [id])
  Role            Role?            @relation(fields: [userRoleID], references: [id])
  contactMessage  contactMessage[]
}

model contactMessage {
  id                String   @id @unique @default(cuid())
  email             String?
  name              String?
  phone             String?
  details           String?
  reason            String?
  serviceCenterName String?
  username          String?
  createdAt         DateTime @default(now())
  deleted           Boolean  @default(false)
  read              Boolean
  user              User[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  resource    RoleToResource[]
  users       User[]
}

model Resources {
  id          String           @id @default(cuid())
  name        String           @unique
  backEndURL  String?
  frontEndURL String?
  Role        RoleToResource[]
}

model RoleToResource {
  roleID     String
  resourceID String
  granted    Boolean   @default(false)
  read       Boolean   @default(false)
  Resource   Resources @relation(fields: [resourceID], references: [id])
  role       Role      @relation(fields: [roleID], references: [id])

  @@id([roleID, resourceID])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ServiceCenter {
  id             String        @id @default(cuid())
  nameKH         String
  nameEN         String
  createdAt      DateTime      @default(now())
  logo           String
  type           String
  directorName   String
  phoneNumber    String
  PoBox          String
  email          String
  website        String
  locationMap    String
  Address        String?
  overview       String?
  background     String?
  mission        String?
  vision         String?
  goal           String?
  ProjectSummary String?
  status         Boolean
  City           String?
  District       String?
  client         Client[]
  staff          Staff[]
  governStaff    governStaff[]
  systemUser     User[]
}

model Staff {
  id                     String         @id @default(cuid())
  photo                  String
  type                   String // មន្រ្តីកិច្ចសន្យា ឬ មន្រ្តីក្របខណ្ឌ
  workingPeroid          String? //មន្ត្រីកិច្ចសន្យា
  attachedContract       String? //មន្ត្រីកិច្ចសន្យា
  attachedBackground     String? // ប្រវត្តិរូបមានរូបថត៤x៦ //មន្ត្រីកិច្ចសន្យា
  attachedFileInfomation String //ព្រឹត្តិប័ត្រព័ត៌មានសម្រាប់ស្នើសុំមន្ត្រីកិច្ចសន្យា
  title                  String
  firstName              String
  lastName               String
  nationality            String
  dateofbirth            String
  birthAddress           String
  brithCity              String?
  birthDistrict          String?
  currentAddress         String?
  currentQualification   String?
  currentCity            String?
  currentDistrict        String?
  sID                    String?
  passport               String?
  workingEXP             Boolean //កិច្ចសន្យា
  workingEXPYes          String?
  gender                 String
  position               String
  telephone              String
  email                  String
  familyAddress          String
  familyPhoneNumber      String
  familyEmail            String
  serviceCenterID        String?
  ServiceCenter          ServiceCenter? @relation(fields: [serviceCenterID], references: [id])
}

model governStaff {
  id                                          String                                        @id @default(cuid())
  photo                                       String
  firstNameKH                                 String
  lastNameKH                                  String
  firstNameEN                                 String
  lastNameEN                                  String
  gender                                      String
  DateofBirth                                 DateTime
  ethnicity                                   String
  nationality                                 String
  birthAddress                                String
  currentAddress                              String
  permanentAddress                            String
  telephone                                   String
  email                                       String
  officialID                                  String
  CambodianSocialID                           String
  sIDValidStart                               DateTime
  sIDValidEnd                                 DateTime
  physical                                    String
  familyInfo                                  String
  spouseNameKH                                String
  spuseNameEN                                 String
  spouseDateOfBirth                           DateTime
  spouseSID                                   String
  spouseBirthAddress                          String
  spouseCurrentOccupation                     String
  spouseOrganisationName                      String
  spuseCurrentAddress                         String
  fatherFullNameKH                            String
  FatherOccupation                            String
  fatherBrithAddress                          String
  MotherOcupation                             String
  motherFullNameKH                            String
  motherBrirthAddress                         String
  ECFirstNameKH                               String
  ECLastNameKH                                String
  ECGender                                    String
  ECRelationshipAs                            String
  ECOccupation                                String
  ECAddress                                   String
  ECTelehpone                                 String
  DateStartOfficialWork                       DateTime
  DateWentFullTime                            DateTime
  CurrentRank                                 String
  OfficialLevelKH                             String
  governStaffChildren                         governStaffChildren[]
  governStaffQualifitcation                   governStaffQualifitcation[]
  governStaffLanuage                          governStaffLanuage[]
  governStaffWorkingHistory                   governStaffWorkingHistory[]
  governStaffPositionHistory                  governStaffPositionHistory[]
  governStaffCertificateLevelup               governStaffCertificateLevelup[]
  governStaffSituationOutsideOriginalOfficial governStaffSituationOutsideOriginalOfficial[]
  GovernStaffFreeNoSalary                     GovernStaffFreeNoSalary[]
  GovernStaffLetterAppreciation               GovernStaffLetterAppreciation[]
  governStaffFineHistory                      governStaffFineHistory[]
  serviceCenterID                             String?
  ServiceCenter                               ServiceCenter?                                @relation(fields: [serviceCenterID], references: [id])
}

model governStaffChildren {
  id            String      @id @default(cuid())
  fullnameKH    String
  gender        String
  dateofBirth   DateTime
  occupation    String
  governStaffID String
  governStaff   governStaff @relation(fields: [governStaffID], references: [id])
}

model governStaffQualifitcation {
  id               String      @id @default(cuid())
  governStaffID    String
  governStaff      governStaff @relation(fields: [governStaffID], references: [id])
  couseLevel       String
  SchoolName       String
  SchoolLocation   String
  CertificateLevel String
  majoring         String
  StartDate        DateTime
  finishDate       DateTime
}

model governStaffLanuage {
  id            String      @id @default(cuid())
  langName      String
  read          String
  conversation  String
  writing       String
  governStaffID String
  governStaff   governStaff @relation(fields: [governStaffID], references: [id])
}

model governStaffWorkingHistory {
  id               String      @id @default(cuid())
  governStaffID    String
  governStaff      governStaff @relation(fields: [governStaffID], references: [id])
  PublicSector     Boolean
  DateStartWorking DateTime
  DateStopWorking  DateTime
  OgnisationName   String
  Department       String
  position         String
  SkillInPosition  String
}

model governStaffPositionHistory {
  id               String      @id @default(cuid())
  governStaffID    String
  governStaff      governStaff @relation(fields: [governStaffID], references: [id])
  ValidDate        DateTime
  MinistryName     String
  Department       String
  OfficialSection  String
  oldOfficialLevel String
  newOffcialLevel  String
  changeTo         String
}

model governStaffCertificateLevelup {
  id                  String      @id @default(cuid())
  governStaffID       String
  governStaff         governStaff @relation(fields: [governStaffID], references: [id])
  validatDate         DateTime
  SchoolName          String
  PlaceStudy          String
  ReceivedCertificate String
  OldPosition         String
  NewPosition         String
}

model governStaffSituationOutsideOriginalOfficial {
  id              String      @id @default(cuid())
  governStaffID   String
  governStaff     governStaff @relation(fields: [governStaffID], references: [id])
  startDate       DateTime
  endDate         DateTime
  OginasationName String
  Position        String
}

model GovernStaffFreeNoSalary {
  id                   String      @id @default(cuid())
  governStaffID        String
  governStaff          governStaff @relation(fields: [governStaffID], references: [id])
  startDate            DateTime
  endDate              DateTime
  Oginisationname      String
  NumberofMonthandYear String
}

model GovernStaffLetterAppreciation {
  id                   String      @id @default(cuid())
  governStaffID        String
  governStaff          governStaff @relation(fields: [governStaffID], references: [id])
  letterNumber         String
  OfficialDate         DateTime
  RequestedOrginsation String
  LetterDetails        String
  TypeReceived         String
}

model governStaffFineHistory {
  id                   String      @id @default(cuid())
  governStaffID        String
  governStaff          governStaff @relation(fields: [governStaffID], references: [id])
  letterNumber         String
  OffialDate           DateTime
  RequestedOrginsation String
  LetterDetails        String
  TypeRecieved         String
}

model Client {
  id              String          @id @unique @default(cuid())
  title           String
  firstname       String?
  lastname        String
  nameEN          String?
  sID             String?
  phoneNumber     String?
  image           String?
  address         String?
  city            String?
  district        String?
  status          Boolean         @default(true)
  serviceCenterID String
  ServiceCenter   ServiceCenter   @relation(fields: [serviceCenterID], references: [id])
  History         ClientHistroy[]
}

model ClientHistroy {
  id          String   @id @unique @default(cuid())
  noteDetails String
  createdAt   DateTime @default(now())
  editedAt    DateTime
  clientID    String
  Client      Client   @relation(fields: [clientID], references: [id])
}
