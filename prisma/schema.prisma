generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
}

model User {
  id              String         @id @unique @default(cuid())
  firstname       String?
  lastname        String?
  username        String         @unique
  password        String
  image           String?
  status          Boolean        @default(true)
  userRoleID      String?
  serviceCenterID String?
  ServiceCenter   ServiceCenter? @relation(fields: [serviceCenterID], references: [id])
  Role            Role?          @relation(fields: [userRoleID], references: [id])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  resource    RoleToResource[]
  users       User[]
}

model Resources {
  id          String           @id @default(cuid())
  name        String           @unique
  backEndURL  String?
  frontEndURL String?
  Role        RoleToResource[]
}

model RoleToResource {
  roleID     String
  resourceID String
  granted    Boolean   @default(false)
  read       Boolean   @default(false)
  Resource   Resources @relation(fields: [resourceID], references: [id])
  role       Role      @relation(fields: [roleID], references: [id])

  @@id([roleID, resourceID])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ServiceCenter {
  id             String   @id @default(cuid())
  nameKH         String
  nameEN         String
  createdAt      DateTime @default(now())
  logo           String
  type           String
  directorName   String
  phoneNumber    String
  PoBox          String
  email          String
  website        String
  locationMap    String
  Address        String?
  overview       String?
  background     String?
  mission        String?
  vision         String?
  goal           String?
  ProjectSummary String?
  status         Boolean
  City           String?
  District       String?
  client         Client[]
  staff          Staff[]
  systemUser     User[]
}

model Staff {
  id              String        @id @default(cuid())
  title           String
  firstName       String
  lastName        String
  gender          String
  position        String
  telephone       String
  email           String
  serviceCenterID String
  ServiceCenter   ServiceCenter @relation(fields: [serviceCenterID], references: [id])
}

model Client {
  id              String        @id @unique @default(cuid())
  firstname       String?
  lastname        String?
  image           String?
  status          Boolean       @default(true)
  serviceCenterID String
  ServiceCenter   ServiceCenter @relation(fields: [serviceCenterID], references: [id])
}
