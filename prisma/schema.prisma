  /// Postgres sequence used as the column default, so concurrent
  /// registrations can never be handed the same number. Never accepted
  /// from the request body — see server/api/client/personalInformation.ts.
  ReadableCode               String                   @unique @default(dbgenerated("('C'::text || lpad((nextval('client_readable_code_seq'::regclass))::text, 5, '0'::text))"))
  Gender                     String
  DOB                        DateTime?
  POB                        String
  EducationLevel             String?
  Occupation                 String?
  DateArrested               DateTime? //កាលបរិចេ្ឆទចូលមជ្ឈមណ្ឌលឬឃាត់ខ្លួន
  homeBA                     String
  StreetBA                   String
  villageBA                  String
  districtBA                 String
  communeBA                  String
  cityProBA                  String
  FatherOrChaperoneName      String?
  FOCDOB                     DateTime?
  FOCTel                     String?
  FOCMarried                 String?
  FOCTelandAddress           String?
  MotherOrChaperoneName      String?
  MOCMarried                 String?
  MOCDOB                     DateTime?
  MOCTel                     String?
  MOCTelandAddress           String?
  OtherFamilyMembers         String?
  CloseFriend                String?
  ClientSendBy               String
  ImportantChallenge         String
  PastActivities             String
  ReasonUseDrug              String
  ReasonUseDrugOther         String?
  KnownLegalConsequence      Boolean
  typeDrugUsed               String
  typeDrugUsedOther          String?
  DrugVolumeUsed             String
  DrugRequecyUse             String
  DrugDurationUse            String
  LivingSituation            String
  UsedtoRehab                Boolean
  HowManyTimeHaveServed      String?
  ReasonComingtoCenter       String?
  DailyActivitiesInCenter    String?
  ActivitiesThatClientLike   String?
  ClientTalent               String?
  RelationshipWithFriends    String?
  RelationshipWithStaff      String?
  RelationshipWithTeacher    String?
  RelationshipWithOther      String?
  ConcernForClientFuture     String?
  HopeForClientFuture        String?
  FuturePlanforClient        String? //options
  FuturePlanforClientDetails String?
  ClientFeelsHopless         Boolean                  @default(false)
  ClientHoplessDetails       String? //Options
  InterviewerOpinoin         String?
  InterviewerID              String
  status                     Boolean                  @default(true)
  InterViewDate              DateTime
  InterViewerSignature       String?
  InterviewerPosition        String?
  serviceCenterID            String
  ServiceCenter              ServiceCenter            @relation(fields: [serviceCenterID], references: [id])
  ClientProgress             ClientProgress[]
  ClientServeHistory         ClientServeHistory[]
  ClientHopelessMultiple     ClientHopelessMultiple[]
  services                   ServicesOnClients[]
  clientServices             ClientService[]

  // Propose → approve (ស្នើឡើង / អនុម័ត / បដិសេធ). Intake staff at a centre
  // submit a record; a ប្រធានមជ្ឈមណ្ឌល or ministry user approves or rejects it.
  approvalStatus  ApprovalStatus @default(DRAFT)
  submittedAt     DateTime?
  submittedByID   String?
  decidedAt       DateTime?
  decidedByID     String?
  rejectionReason String?
}

/// One row per transition, so a record's history survives the record being
/// edited. Deliberately not a relation to each record type — `recordId` is
/// matched with `recordType` instead, so one table covers all six forms.
model ApprovalEvent {
  id         String             @id @default(cuid())
  recordType ApprovalRecordType
  recordId   String
  fromStatus ApprovalStatus?
  toStatus   ApprovalStatus
  actorID    String
  actor      User               @relation(fields: [actorID], references: [id])
  reason     String?
  note       String?
  createdAt  DateTime           @default(now())

  // Reading a record's history: filter by record, order by time. Covers plain
  // [recordType, recordId] lookups too, since those are a prefix of this.
  @@index([recordType, recordId, createdAt])
  // "What has this user approved?" — Postgres doesn't index a foreign key for
  // you, and RESTRICT means every user delete scans this table.
  @@index([actorID])
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ApprovalRecordType {
  CLIENT
  CLIENT_SERVICE
  CASE_PLAN
  REINTEGRATION
  FOLLOW_UP
  CASE_CLOSURE
}

