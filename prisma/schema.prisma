model Service {
  id                     String                          @id @default(cuid())
  /// លេខកូដ. The manual writes every service reference as (លេខកូដ*, ឈ្មោះខ្មែរ,
  /// ឈ្មោះអង់គ្លេស, បរិយាយ) and marks the code required, but this table was
  /// keyed only by name. Filled from a sequence when left blank, as
  /// ClientType.code and Client ReadableCode are, so an official ministry code
  /// can still be typed in and kept.
  code                   String                          @unique @default(dbgenerated("('SV'::text || lpad((nextval('service_code_seq'::regclass))::text, 3, '0'::text))"))
  nameKh                 String                          @unique // ឈ្មោះសេវា
  /// ឈ្មោះសេវា (អង់គ្លេស). Optional on purpose: the manual asks for it, and five
  /// forms display service names, but a centre entering a service in Khmer
  /// should not be blocked for want of a translation. Where it is missing the
  /// UI falls back to nameKh in either language.
  nameEn                 String?
  providingInstitution   String? // ក្រសួង/ស្ថាប័ន ផ្តល់សេវា
  purpose                String? // គោលបំណង នៃការផ្តល់សេវា
  legalBasis             String? // មូលដ្ឋានគតិយុត្ត
  eligibleClients        String? // អតិថិជនដែលមាន សិទ្ធិទទួលសេវា
  serviceStandard        String? // ស្តង់ដារសេវា
  requiredDocuments      String? // តម្រូវការឯកសារ ដើម្បីទទួលបានសេវា
  feedback               String? // យោបល់
  isActive               Boolean                         @default(true)
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  clients                ServicesOnClients[]
  clientServices         ClientService[]                 @relation("ClientServiceCatalogue")
  followUpFor            ClientService[]                 @relation("ClientServiceFollowUp")
  casePlanActivities     CasePlanActivity[]              @relation("CasePlanActivityService")
  reintegrationPast      ReintegrationPastService[]      @relation("ReintegrationPastService")
  reintegrationCommunity ReintegrationCommunityService[] @relation("ReintegrationCommunityService")
  followUpServices       FollowUpService[]               @relation("FollowUpService")
  serviceCenters         ServicesOnServiceCenters[]

  @@map("services")
}

model ServicesOnClients {
  client     Client_PersonalInformation @relation(fields: [clientId], references: [id])
  clientId   String
  service    Service                    @relation(fields: [serviceId], references: [id])
  serviceId  String
  assignedAt DateTime                   @default(now())
  assignedBy String?

  @@id([clientId, serviceId])
}

model ServicesOnServiceCenters {
  serviceCenter   ServiceCenter @relation(fields: [serviceCenterId], references: [id])
  serviceCenterId String
  service         Service       @relation(fields: [serviceId], references: [id])
  serviceId       String

  @@id([serviceCenterId, serviceId])
}

// ───────────────────────────────────────────────────────────────────────────
// Reference taxonomies
//
// The manual's ការកំណត់* screens. Forms 2–6 (service use, case plan,
// reintegration, follow-up, closure) all select from these lists rather than
// storing free text, so they are the dependency for the rest of the
// case-management build. Client records currently keep this sort of thing as
// loose String columns, which is what these replace.
//
// Every entity carries Khmer and English names because the spec requires a
// language switcher; `code` is the ministry's លេខកូដ and is the stable handle
// for a row, so it is unique.
// ───────────────────────────────────────────────────────────────────────────

/// ប្រភេទអតិថិជន — the kind of person a case is about (orphan, juvenile in
/// conflict with the law, trafficking victim, and so on).
model ClientType {
  id             String          @id @default(cuid())
  /// លេខកូដ. Entered by hand when the ministry has an official code for the
  /// category; otherwise left out and the database fills it from a sequence,
  /// the same way Client_PersonalInformation.ReadableCode works. Doing it in
  /// the default rather than in the handler keeps it race-free without a
  /// read-then-write.
  code           String          @unique @default(dbgenerated("('CT'::text || lpad((nextval('client_type_code_seq'::regclass))::text, 3, '0'::text))"))
  nameKh         String // ឈ្មោះ (ខ្មែរ)
  nameEn         String? // ឈ្មោះ (អង់គ្លេស)
  description    String? // បរិយាយ
  isActive       Boolean         @default(true)
  clientServices ClientService[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("clientTypes")
}

/// ប្រភេទសេវាកម្ម — the category a service falls under. Distinct from
/// `Service`, which is a specific catalogued programme with its legal basis.
model ServiceType {
  id          String   @id @default(cuid())
  code        String   @unique // លេខកូដ
  nameKh      String // ឈ្មោះសេវា (ខ្មែរ)
  nameEn      String? // ឈ្មោះសេវា (អង់គ្លេស)
  description String? // បរិយាយ
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("serviceTypes")
}

/// ក្រុមសម្ភារៈ ឬឧបករណ៍ជំនួយ — assistive material and device groups.
model AssistiveGroup {
  id          String          @id @default(cuid())
  nameKh      String // ឈ្មោះសម្ភារៈ (ខ្មែរ)
  nameEn      String? // ឈ្មោះសម្ភារៈ (អង់គ្លេស)
  description String? // បរិយាយ
  isActive    Boolean         @default(true)
  types       AssistiveType[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("assistiveGroups")
}

/// ប្រភេទសម្ភារៈ ឬឧបករណ៍ជំនួយ
model AssistiveType {
  id          String            @id @default(cuid())
  code        String            @unique // លេខកូដ
  groupId     String // ក្រុម
  group       AssistiveGroup    @relation(fields: [groupId], references: [id])
  nameKh      String // ឈ្មោះ (ខ្មែរ)
  nameEn      String? // ឈ្មោះ (អង់គ្លេស)
  description String? // បរិយាយ
  isActive    Boolean           @default(true)
  items       AssistiveDevice[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([groupId])
  @@map("assistiveTypes")
}

/// សម្ភារៈ ឬឧបករណ៍ជំនួយ — the individual item that can be issued or repaired
/// for a client. Photo is stored the same way as elsewhere: a path under
/// `public/uploads`, written by server/utils/uploads.ts.
model AssistiveDevice {
  id          String        @id @default(cuid())
  code        String        @unique // លេខកូដ
  typeId      String // ប្រភេទសម្ភារៈ ឬឧបករណ៍ជំនួយ
  type        AssistiveType @relation(fields: [typeId], references: [id])
  photo       String? // រូបភាព
  nameKh      String // ឈ្មោះ (ខ្មែរ)
  nameEn      String? // ឈ្មោះ (អង់គ្លេស)
  description String? // បរិយាយ
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([typeId])
  @@map("assistiveDevices")
}

/// ទម្រង់ទី២ — ការប្រើសេវាកម្មរបស់អតិថិជន.
///
/// Section 1 of the paper form (client code, name, family phone) is not stored
/// again: it is read from the linked Client_PersonalInformation. A client can
/// have many of these, one per episode of service.
model ClientService {
  id       String                     @id @default(cuid())
  clientId String
  client   Client_PersonalInformation @relation(fields: [clientId], references: [id])

  // ២. ព័ត៌មានរោគឬសញ្ញាណវិនិច្ឆ័យ
  //
  // The manual repeats three questions from ទម្រង់ទី១ here — whether the client
  // has been in a centre before, which ones, and how many times. They are not
  // stored again: Client_PersonalInformation already holds UsedtoRehab,
  // HowManyTimeHaveServed and the ClientServeHistory rows, and a second copy
  // would only be able to disagree with the first.
  clientTypeId        String? // ប្រភេទអតិថិជន
  clientType          ClientType? @relation(fields: [clientTypeId], references: [id])
  reason              String? // មូលហេតុ
  attachments         String? // ឯកសារពាក់ព័ន្ធ — comma separated, as CenterPlan.filePath
  diagnosisApprovedBy String? // អនុម័តរោគវិនិច្ឆ័យដោយ
  conclusion          String? // សន្និដ្ឋាន

  // ៣. ព័ត៌មានសេវាកម្មដែលត្រូវការប្រើ
  //
  // The service comes from the catalogue maintained at /service — the one
  // carrying each programme's legal basis and eligibility.
  //
  // This section also used to carry three narrowing levels, ក្រុមស្តារនីតិសម្បទា
  // -> ប្រភេទស្តារនីតិសម្បទា -> សេវាកម្មស្តារនីតិសម្បទាលម្អិត. They were dropped
  // deliberately: the manual names only the first two levels and only for four
  // of the seven groups, so three groups dead-ended with an empty second
  // dropdown and the third level had no source of values at all. Bringing them
  // back means answering where the ministry's list and its codes come from.
  serviceDate DateTime? // ថ្ងៃខែឆ្នាំមកទទួលសេវាកម្ម
  serviceId   String? // សេវាកម្ម
  service     Service?  @relation("ClientServiceCatalogue", fields: [serviceId], references: [id])

  // ៤. អ្នកផ្តល់សេវា និងស្ថានភាពអតិថិជនបច្ចុប្បន្ន
  providerName      String? // ឈ្មោះស្ថាប័នផ្តល់សេវា
  providerLocation  String? // ទីតាំងផ្តល់សេវា
  providerAgent     String? // ឈ្មោះភ្នាក់ងារផ្តល់សេវា
  providerPhone     String? // លេខទំនាក់ទំនង
  currentStatus     String? // មិនល្អ / ប្រសើរ / ប្រក្រតីភាព
  followUpServiceId String? // តម្រូវការសេវាបន្ត
  followUpService   Service? @relation("ClientServiceFollowUp", fields: [followUpServiceId], references: [id])

  // ៥. សិទ្ធិអនុម័ត — same fields as Client_PersonalInformation so one approval
  // component serves every form.
  approvalStatus  ApprovalStatus @default(DRAFT)
  submittedAt     DateTime?
  submittedByID   String?
  decidedAt       DateTime?
  decidedByID     String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([approvalStatus])
  @@map("clientServices")
}

/// ទម្រង់ទី៣ ផែនការករណីរបស់អតិថិជន — the plan of services agreed for a client.
///
/// Many per client rather than one: a plan gets revised as a case develops, and
/// a single row would mean overwriting what was agreed before.
///
/// Section ១ of the manual (code, name, gender, age, family phone, family
/// address) is not stored here. Client_PersonalInformation already holds all of
/// it, so it is read through the relation and shown on the form and the
/// printout — a second copy could only disagree with the first.
model CasePlan {
  id       String                     @id @default(cuid())
  clientId String
  client   Client_PersonalInformation @relation(fields: [clientId], references: [id])

  // ២. ផែនការ
  providerName        String? // ស្ថាប័នទទួលផ្តល់សេវា
  socialWorkerName    String? // ឈ្មោះបុគ្គលិកសង្គម
  socialWorkerPhone   String? // លេខទំនាក់ទំនង ឬអ៊ីម៊ែល
  referralReason      String? // មូលហេតុនៃការបញ្ជូនទទួលសេវា
  challenges          String? // បញ្ហាប្រឈម
  situationAssessment String? // ការវាយតម្លៃស្ថានភាពបច្ចុប្បន្ន

  /// ក. សកម្មភាពសេវាកម្ម — the manual says អាចបន្ថែមច្រើនទៀត, so this is a child
  /// table rather than a fixed set of columns.
  activities CasePlanActivity[]

  // ៣. កាលបរិច្ឆេទតាមដាន ត្រួតពិនិត្យ
  //
  // One set, not a list. The manual writes it once and ends it with a "next
  // follow-up" date pointing forward; ទម្រង់ទី៥ តាមដាន និងវាយតម្លៃ is the form
  // that records each follow-up as it happens.
  monitorDate     DateTime? // កាលបរិច្ឆេទតាមដាន
  monitorMethod   String? // សង្កេតពីចម្ងាយ / អង្កេត / សម្ភាសន៍ / របាយការណ៍អ្នកផ្តល់សេវា
  monitorResult   String? // មិនប្រក្រតី / ផ្អាកដំណើការ / ដំណើការធម្មតា / ល្អប្រសើរជាងមុន
  nextMonitorDate DateTime? // កាលបរិច្ឆេទតាមដានបន្ត

  // ៤. សេចក្តីសន្និដ្ឋាន — the heading the manual gives the approval block. The
  // free-text conclusion sits with it; the submit/approve fields below are the
  // same shape every ទម្រង់ uses so one component serves them all.
  conclusion String? // សេចក្តីសន្និដ្ឋាន

  approvalStatus  ApprovalStatus @default(DRAFT)
  submittedAt     DateTime?
  submittedByID   String?
  decidedAt       DateTime?
  decidedByID     String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([approvalStatus])
  @@map("casePlans")
}

/// One row of ក. សកម្មភាពសេវាកម្ម — a service from the /service catalogue with
/// the dates it runs between.
model CasePlanActivity {
  id         String   @id @default(cuid())
  casePlanId String
  /// Cascade: these rows are part of the plan, not records in their own right.
  /// Deleting a plan should take its activities, not leave them orphaned or
  /// refuse the delete.
  casePlan   CasePlan @relation(fields: [casePlanId], references: [id], onDelete: Cascade)

  serviceId String? // (លេខកូដ, ឈ្មោះសេវា ខ្មែរ/អង់គ្លេស, បរិយាយ)
  service   Service?  @relation("CasePlanActivityService", fields: [serviceId], references: [id])
  startDate DateTime? // កាលបរិច្ឆេទចាប់ផ្តើម
  endDate   DateTime? // កាលបរិច្ឆេទបញ្ចប់

  /// The manual numbers the rows ១, ២, ៣ …, so their order is part of the plan
  /// and cannot be left to whatever the database returns.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([casePlanId, sortOrder])
  @@index([serviceId])
  @@map("casePlanActivities")
}

/// ទម្រង់ទី៤ សមាហរណកម្ម — reintegrating a client back into their community.
///
/// Many per client, as the other episode forms are. Section ១ is read through
/// the client relation rather than copied, the same as ទម្រង់ទី៣.
model Reintegration {
  id       String                     @id @default(cuid())
  clientId String
  client   Client_PersonalInformation @relation(fields: [clientId], references: [id])

  // ២. ស្ថានភាពបច្ចុប្បន្ន
  consultation String? // សេចក្តីពិគ្រោះយោបល់
  /// សេវាកម្មដែលបានទទួលកន្លងមក
  pastServices ReintegrationPastService[]

  // ៣. គោលដៅ
  handoverDate    DateTime? // កាលបរិច្ឆេទទទួល
  recipient       String? // ឱពុកម្តាយ / អាណាព្យាបាល / ឱពុកម្តាយធម៌ / សាច់ញាតិ / អាជ្ញាធរមានសមត្ថកិច្ច
  /// លេខទូរស័ព្ទទំនាក់ទំនង. The manual asks for យ៉ាងតិច២ខ្សែរ — at least two
  /// lines — so both are their own column rather than one field holding a
  /// comma-separated pair nobody can search.
  recipientPhone1 String?
  recipientPhone2 String?

  // អភិបាលកិច្ចសហគមន៍ — the local officials who will keep an eye on the client.
  // Flat columns rather than a table: the manual fixes exactly two named posts
  // and one free-text body, and a three-row table with fixed roles is a table
  // pretending to be a form.
  communeChiefName  String? // ក. មេឃុំ ចៅសង្កាត់
  communeChiefSex   String?
  communeChiefAge   Int?
  communeChiefPhone String?
  villageChiefName  String? // ខ. មេភូមិ
  villageChiefSex   String?
  villageChiefAge   Int?
  villageChiefPhone String?
  localOrganisation String? // គ. អង្គភាព/អង្គការមូលដ្ឋាន

  /// Upload កិច្ចសន្យា ការផ្តល់សេវាកម្មនៅសហគមន៍ និងឯកសារពាក់ព័ន្ធ.
  /// Comma separated, as ClientService.attachments and CenterPlan.filePath are.
  goalAttachments String?

  // ៤. សេវាកម្មនៅសហគមន៍ត្រូវផ្តល់បន្ត
  communityServices    ReintegrationCommunityService[]
  /// Upload កិច្ចសន្យា គ្រួសារ ឬអ្នកថែទាំបន្ត. A second, separate upload: the
  /// manual attaches it to its own section, and the community-service contract
  /// and the family-carer contract are different documents.
  communityAttachments String?

  // ៥. ការតាមដាន និងវាយតម្លៃ
  monitorDate     DateTime? // កាលបរិច្ឆេទតាមដាន
  /// អ្នកផ្តល់ព័តមាន — ជ្រើសរើសបានច្រើន, so comma separated rather than one
  /// value. The other three below are single choice.
  informants      String?
  monitorMethod   String?
  monitorResult   String?
  nextMonitorDate DateTime? // កាលបរិច្ឆេទតាមដានបន្ត

  // ៦. សិទ្ធិធ្វើសេចក្តីសន្និដ្ឋាន
  conclusion String?

  approvalStatus  ApprovalStatus @default(DRAFT)
  submittedAt     DateTime?
  submittedByID   String?
  decidedAt       DateTime?
  decidedByID     String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([approvalStatus])
  @@map("reintegrations")
}

/// One row of ២. សេវាកម្មដែលបានទទួលកន្លងមក — a service already delivered, with
/// how it turned out.
model ReintegrationPastService {
  id              String        @id @default(cuid())
  reintegrationId String
  reintegration   Reintegration @relation(fields: [reintegrationId], references: [id], onDelete: Cascade)

  serviceId String?
  service   Service?  @relation("ReintegrationPastService", fields: [serviceId], references: [id])
  startDate DateTime?
  endDate   DateTime?
  /// លទ្ធផល. A different list from the monitoring one: this asks how a finished
  /// service turned out (…, សះស្បើយ), not how the client is doing right now.
  outcome   String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reintegrationId, sortOrder])
  @@index([serviceId])
  @@map("reintegrationPastServices")
}

/// One row of ៤. សេវាកម្មនៅសហគមន៍ត្រូវផ្តល់បន្ត — a service to continue in the
/// community. No outcome: it has not happened yet.
model ReintegrationCommunityService {
  id              String        @id @default(cuid())
  reintegrationId String
  reintegration   Reintegration @relation(fields: [reintegrationId], references: [id], onDelete: Cascade)

  serviceId String?
  service   Service?  @relation("ReintegrationCommunityService", fields: [serviceId], references: [id])
  startDate DateTime?
  endDate   DateTime?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reintegrationId, sortOrder])
  @@index([serviceId])
  @@map("reintegrationCommunityServices")
}

/// ទម្រង់ទី៥ តាមដាន និងវាយតម្លៃស្ថានភាពអតិថិជន — one follow-up visit.
///
/// Many per client: this is the form that records each follow-up as it happens,
/// which is why ទម្រង់ទី៣ keeps only a single next-follow-up date pointing here.
///
/// The manual opens with ជ្រើសរើស (២)ឬ(៣) ដើម្បីបំពេញទិន្នន័យ — a visit is either
/// one kind of follow-up or the other, never both. `stage` records which, so a
/// printed form matches the paper instruction and "which kind of follow-up was
/// this" stays a question the database can answer, rather than one inferred
/// from which columns happen to be null.
model FollowUp {
  id       String                     @id @default(cuid())
  clientId String
  client   Client_PersonalInformation @relation(fields: [clientId], references: [id])

  /// IN_CENTRE = section ២, POST_REINTEGRATION = section ៣.
  stage FollowUpStage @default(IN_CENTRE)

  // Asked by both sections, so held once rather than twice over.
  monitorDate     DateTime? // កាលបរិច្ឆេទតាមដាន
  monitorMethod   String? // វិធីសាស្រ្តតាមដាន
  nextMonitorDate DateTime? // កាលបរិច្ឆេទតាមដានបន្ត
  /// Upload ឯកសារពាក់ព័ន្ធបើមាន. One column: the manual puts an upload in each
  /// section, but only one section is ever filled in, so a second column would
  /// always be empty.
  attachments     String?

  // ២. ការអនុវត្តផែនការសកម្មភាពផ្តល់សេវាកម្ម — in-centre only.
  services FollowUpService[]

  // ៣. ក្រោយពេលធ្វើសមាហរណកម្មទៅសហគមន៍ — post-reintegration only.
  /// អ្នកផ្តល់ព័តមាន — ជ្រើសរើសបានច្រើន, comma separated as ទម្រង់ទី៤ stores it.
  informants    String?
  /// លទ្ធផល for the visit as a whole. Section ២ records its outcome per service
  /// instead, on the rows above.
  monitorResult String?

  // ៤. សិទ្ធិធ្វើសេចក្តីសន្និដ្ឋាន
  conclusion String?

  approvalStatus  ApprovalStatus @default(DRAFT)
  submittedAt     DateTime?
  submittedByID   String?
  decidedAt       DateTime?
  decidedByID     String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([approvalStatus])
  @@map("followUps")
}

enum FollowUpStage {
  IN_CENTRE
  POST_REINTEGRATION
}

/// One row of ២ — a planned service, with how it is going.
model FollowUpService {
  id         String   @id @default(cuid())
  followUpId String
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  serviceId String?
  service   Service?  @relation("FollowUpService", fields: [serviceId], references: [id])
  startDate DateTime?
  endDate   DateTime?
  /// លទ្ធផល. A third list again: five options here, where ទម្រង់ទី៤'s finished
  /// services offer four without ដំណើការធម្មតា and the monitoring lists offer
  /// four without សះស្បើយ. The manual writes all three separately.
  outcome   String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([followUpId, sortOrder])
  @@index([serviceId])
  @@map("followUpServices")
}

/// ទម្រង់ទី៦ បិទករណី — closing a client's case.
///
/// Many per client, as the other episode forms are: a case closing is terminal
/// for that episode, but a client can be re-admitted and closed again.
///
/// Closing does not touch the client record. Nothing in the manual says a
/// closure retires a client from the active register, so it does not — if that
/// is wanted it should be a deliberate decision, not a side effect of filing
/// this form.
model CaseClosure {
  id       String                     @id @default(cuid())
  clientId String
  client   Client_PersonalInformation @relation(fields: [clientId], references: [id])

  // ២. មូលហេតុនៃការបិទករណី ឬបញ្ចេញពីមជ្ឈមណ្ឌល
  //
  // The manual lists ក.សមាហរណកម្មជោគជ័យ and ខ.សមាហរណកម្មមិនជោគជ័យ one after the
  // other without saying to pick one, but they contradict each other: a case
  // closed successfully cannot also have absconding as its reason. `outcome`
  // records which of the two this closure was, so a record cannot hold both and
  // "how many closed successfully" is a query rather than a guess at which
  // columns are null. Unlike ទម្រង់ទី៥'s stage this is not stated in the manual
  // — it is a decision taken with the user.
  outcome ClosureOutcome @default(SUCCESSFUL)

  /// ក. One of three, single choice. The third is ផ្សេងទៀត, whose text goes in
  /// successReasonOther.
  successReason      String?
  successReasonOther String? // បញ្ជាក់ for ផ្សេងទៀត

  /// ខ. ជ្រើសរើសបានច្រើន — comma separated, as the other multi-selects store it.
  failureReasons String?

  // ៣. កំណត់សម្គាល់ is not stored. It is the manual's own definition of a stable
  // reintegration, identical on every form, so it is rendered as guidance and
  // printed with the record rather than copied into every row.

  // ៤. សេចក្តីសង្ខេបសន្និដ្ឋាន
  // ក. ករណីសិក្សាមណ្ឌល
  centreStrengths          String? // ចំណុចខ្លាំងនៃសេវាកម្មបានផ្តល់
  centreWeaknesses         String? // ចំណុចខ្សោយនៃសេវាកម្មបានផ្តល់
  centreVulnerabilities    String? // ភាពងាយរងគ្រោះនានាអាចកើត
  // ខ. ករណីសិក្សានៅសហគមន៍
  communityStrengths       String?
  communityWeaknesses      String?
  communityVulnerabilities String?
  // គ. គម្រោងអនាគតរបស់ជនរងគ្រោះគួទទួលបាន
  futurePlan               String?

  // ៥. សិទ្ធិធ្វើសេចក្តីសន្និដ្ឋាន
  approvalStatus  ApprovalStatus @default(DRAFT)
  submittedAt     DateTime?
  submittedByID   String?
  decidedAt       DateTime?
  decidedByID     String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([approvalStatus])
  @@map("caseClosures")
}

enum ClosureOutcome {
  SUCCESSFUL
  UNSUCCESSFUL
}

/// មតិយោបល់ — what a user has to say about the system itself.
///
/// Anyone signed in may write one; who may read them is a grant, so the
/// ministry decides that rather than it being fixed here.
///
/// The author is recorded by relation and their name and centre are also copied
/// in as plain text. That is deliberate duplication: feedback outlives the
/// account that wrote it, and a complaint whose author was later deleted should
/// still say who raised it and from where. `userID` is SetNull for the same
/// reason — losing the link must not lose the message.
model Feedback {
  id              String   @id @default(cuid())
  message         String
  createdAt       DateTime @default(now())
  /// Read, so a long list can be worked through without losing your place.
  handled         Boolean  @default(false)
  userID          String?
  user            User?    @relation(fields: [userID], references: [id], onDelete: SetNull)
  /// Kept as text — see the note above.
  authorName      String?
  serviceCenterID String?
  centreName      String?

  @@index([createdAt])
  @@map("feedback")
}

/// អំពីយើង — the About page, written by the ministry.
///
/// One row, always. `id` defaults to a constant rather than a cuid so there is
/// no way to end up with two competing versions of a page that is singular by
/// definition — the endpoint upserts on it.
///
/// Khmer only, matching the decision that recorded content stays in Khmer. The
/// heading and chrome around it still translate; this is the ministry's own
/// text, and a half-translated About page reads worse than one in the language
/// it was written in.
model AboutPage {
  id          String   @id @default("about")
  title       String?
  content     String?
  updatedAt   DateTime @updatedAt
  updatedByID String?

  @@map("aboutPage")
}
