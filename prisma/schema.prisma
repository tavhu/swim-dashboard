generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
}

model User {
  id              String           @id @unique @default(cuid())
  firstname       String?
  lastname        String?
  username        String           @unique
  password        String
  image           String?
  status          Boolean          @default(true)
  userRoleID      String?
  serviceCenterID String?
  ServiceCenter   ServiceCenter?   @relation(fields: [serviceCenterID], references: [id])
  Role            Role?            @relation(fields: [userRoleID], references: [id])
  contactMessage  contactMessage[]
}

model contactMessage {
  id                String   @id @unique @default(cuid())
  email             String?
  name              String?
  phone             String?
  details           String?
  reason            String?
  serviceCenterName String?
  username          String?
  createdAt         DateTime @default(now())
  deleted           Boolean  @default(false)
  read              Boolean
  user              User[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  resource    RoleToResource[]
  users       User[]
}

model Resources {
  id          String           @id @default(cuid())
  name        String           @unique
  backEndURL  String?
  frontEndURL String?
  Role        RoleToResource[]
}

model RoleToResource {
  roleID     String
  resourceID String
  granted    Boolean   @default(false)
  read       Boolean   @default(false)
  Resource   Resources @relation(fields: [resourceID], references: [id])
  role       Role      @relation(fields: [roleID], references: [id])

  @@id([roleID, resourceID])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ServiceCenter {
  id                         String                       @id @default(cuid())
  nameKH                     String
  nameEN                     String
  createdAt                  DateTime                     @default(now())
  logo                       String
  type                       String
  directorName               String
  phoneNumber                String
  PoBox                      String
  email                      String
  website                    String
  locationMap                String
  Address                    String?
  overview                   String?
  background                 String?
  mission                    String?
  vision                     String?
  goal                       String?
  ProjectSummary             String?
  status                     Boolean
  City                       String?
  District                   String?
  Client_PersonalInformation Client_PersonalInformation[]
  staff                      Staff[]
  governStaff                governStaff[]
  systemUser                 User[]
}

model Staff {
  id                         String                       @id @default(cuid())
  photo                      String
  firstName                  String
  lastName                   String
  fullnameEN                 String?
  nationality                String
  dateofbirth                String
  birthAddress               String
  brithCity                  String?
  birthDistrict              String?
  currentAddress             String?
  currentQualification       String?
  currentCity                String?
  currentDistrict            String?
  sID                        String?
  passport                   String?
  workingEXP                 Boolean //កិច្ចសន្យា
  workingEXPYes              String?
  gender                     String
  position                   String
  telephone                  String
  familyAddress              String
  familyPhoneNumber          String
  familyEmail                String
  workingPeroidStart         DateTime //មន្ត្រីកិច្ចសន្យា
  workingContractAt          String?
  attachedContract           String? //មន្ត្រីកិច្ចសន្យា
  attachedBackground         String? //ប្រវត្តិរូបមានរូបថត៤x៦ //មន្ត្រីកិច្ចសន្យា
  attachedFileInfomation     String? //ព្រឹត្តិប័ត្រព័ត៌មានសម្រាប់ស្នើសុំមន្ត្រីកិច្ចសន្យា
  serviceCenterID            String?
  ServiceCenter              ServiceCenter?               @relation(fields: [serviceCenterID], references: [id])
  Client_PersonalInformation Client_PersonalInformation[]
}

model governStaff {
  id                                          String                                        @id @default(cuid())
  photo                                       String?
  firstNameKH                                 String
  lastNameKH                                  String
  firstNameEN                                 String
  lastNameEN                                  String
  gender                                      String
  DateofBirth                                 DateTime
  ethnicity                                   String
  nationality                                 String
  birthAddress                                String
  currentAddress                              String
  permanentAddress                            String
  telephone                                   String
  email                                       String
  officialID                                  String
  CambodianSocialID                           String
  sIDValidStart                               DateTime
  sIDValidEnd                                 DateTime
  physical                                    String
  familyInfo                                  String
  spouseNameKH                                String?
  spuseNameEN                                 String?
  spouseDateOfBirth                           DateTime?
  spouseSID                                   String?
  spouseBirthAddress                          String?
  spouseCurrentOccupation                     String?
  spouseOrganisationName                      String?
  spuseCurrentAddress                         String?
  fatherFullNameKH                            String
  FatherOccupation                            String
  fatherBrithAddress                          String
  MotherOcupation                             String
  motherFullNameKH                            String
  motherBrirthAddress                         String
  ECFirstNameKH                               String
  ECLastNameKH                                String
  ECGender                                    String
  ECRelationshipAs                            String
  ECOccupation                                String
  ECAddress                                   String
  ECTelehpone                                 String
  DateStartOfficialWork                       DateTime
  DateWentFullTime                            DateTime
  CurrentRank                                 String
  OfficialLevelKH                             String
  serviceCenterID                             String?
  governStaffChildren                         governStaffChildren[]
  governStaffQualifitcation                   governStaffQualifitcation[]
  governStaffLanuage                          governStaffLanuage[]
  governStaffWorkingHistoryPublic             governStaffWorkingHistoryPublic[]
  governStaffPositionHistory                  governStaffPositionHistory[]
  governStaffCertificateLevelup               governStaffCertificateLevelup[]
  governStaffSituationOutsideOriginalOfficial governStaffSituationOutsideOriginalOfficial[]
  governStaffFreeNoSalary                     governStaffFreeNoSalary[]
  governStaffLetterAppreciation               governStaffLetterAppreciation[]
  governStaffFineHistory                      governStaffFineHistory[]
  ServiceCenter                               ServiceCenter?                                @relation(fields: [serviceCenterID], references: [id])
  governStaffWorkingHistoryPrivate            governStaffWorkingHistoryPrivate[]
  Client_PersonalInformation                  Client_PersonalInformation[]
}

model governStaffChildren {
  id            String      @id @default(cuid())
  fullnameKH    String
  gender        String
  dateofBirth   DateTime
  occupation    String
  governStaffID String
  governStaff   governStaff @relation(fields: [governStaffID], references: [id])
}

model governStaffQualifitcation {
  id               String      @id @default(cuid())
  governStaff      governStaff @relation(fields: [governStaffID], references: [id])
  governStaffID    String
  couseLevel       String
  SchoolName       String
  SchoolLocation   String
  CertificateLevel String
  majoring         String
  StartDate        DateTime
  finishDate       DateTime
}

model governStaffLanuage {
  id            String      @id @default(cuid())
  langName      String
  read          String
  conversation  String
  writing       String
  governStaffID String
  governStaff   governStaff @relation(fields: [governStaffID], references: [id])
}

model governStaffWorkingHistoryPublic {
  id               String      @id @default(cuid())
  governStaff      governStaff @relation(fields: [governStaffID], references: [id])
  governStaffID    String
  DateStartWorking DateTime
  DateStopWorking  DateTime
  OgnisationName   String
  Department       String
  position         String
  SkillInPosition  String
}

model governStaffWorkingHistoryPrivate {
  id               String      @id @default(cuid())
  governStaff      governStaff @relation(fields: [governStaffID], references: [id])
  governStaffID    String
  DateStartWorking DateTime
  DateStopWorking  DateTime
  OgnisationName   String
  position         String
  SkillInPosition  String
}

model governStaffPositionHistory {
  id               String      @id @default(cuid())
  governStaff      governStaff @relation(fields: [governStaffID], references: [id])
  ValidDate        DateTime
  governStaffID    String
  MinistryName     String
  Department       String
  OfficialSection  String
  oldOfficialLevel String
  newOffcialLevel  String
  changeTo         String
}

model governStaffCertificateLevelup {
  id                  String      @id @default(cuid())
  governStaff         governStaff @relation(fields: [governStaffID], references: [id])
  governStaffID       String
  validatDate         DateTime
  SchoolName          String
  PlaceStudy          String
  ReceivedCertificate String
  OldPosition         String
  NewPosition         String
}

model governStaffSituationOutsideOriginalOfficial {
  id              String      @id @default(cuid())
  governStaff     governStaff @relation(fields: [governStaffID], references: [id])
  governStaffID   String
  startDate       DateTime
  endDate         DateTime
  OginasationName String
  Position        String
}

model governStaffFreeNoSalary {
  id                   String      @id @default(cuid())
  governStaff          governStaff @relation(fields: [governStaffID], references: [id])
  governStaffID        String
  startDate            DateTime
  endDate              DateTime
  Oginisationname      String
  NumberofMonthandYear String
}

model governStaffLetterAppreciation {
  id                   String      @id @default(cuid())
  governStaff          governStaff @relation(fields: [governStaffID], references: [id])
  governStaffID        String
  letterNumber         String
  OfficialDate         DateTime
  RequestedOrginsation String
  LetterDetails        String
  TypeReceived         String
}

model governStaffFineHistory {
  id                   String      @id @default(cuid())
  governStaff          governStaff @relation(fields: [governStaffID], references: [id])
  governStaffID        String
  letterNumber         String
  OffialDate           DateTime
  RequestedOrginsation String
  LetterDetails        String
  TypeRecieved         String
}

model Client_PersonalInformation {
  id                         String               @id @unique @default(cuid())
  fullNameKH                 String
  nickName                   String
  ReadableCode               String
  IdentifyCode               String
  Gender                     String
  DOB                        DateTime?
  POB                        String
  EducationLevel             String?
  Occupation                 String?
  DateArrested               String? //កាលបរិចេ្ឆទចូលមជ្ឈមណ្ឌលឬឃាត់ខ្លួន
  homeBA                     String
  StreetBA                   String
  villageBA                  String
  districtBA                 String
  commuteBA                  String
  cityProBA                  String
  FatherOrChaperoneName      String?
  FOCDOB                     DateTime?
  FOCTel                     String?
  FOCMarried                 String?
  FOCTelandAddress           String?
  MotherOrChaperoneName      String?
  MOCMarried                 String?
  MOCDOB                     DateTime?
  MOCTel                     String?
  MOCTelandAddress           String?
  OtherFamilyMembers         String?
  CloseFriend                String?
  ClientSendBy               String
  ImportantChallenge         String
  PastActivities             String
  ReasonUseDrug              String
  ReasonUseDrugOther         String?
  KnownLegalConsequence      Boolean
  typeDrugUsed               String
  typeDrugUsedOther          String?
  DrugVolumeUsed             String
  DrugRequecyUse             String
  DrugDurationUse            String
  LivingSituation            String
  UsedtoRehab                Boolean
  HowManyTimeHaveServed      String?
  ReasonComingtoCenter       String?
  DailyActivitiesInCenter    String?
  ActivitiesThatClientLike   String?
  ClientTalent               String?
  RelationshipWithFriends    String?
  RelationshipWithStaff      String?
  RelationshipWithTeacher    String?
  RelationshipWithOther      String?
  ConcernForClientFuture     String?
  HopeForClientFuture        String?
  FuturePlanforClient        String? //options
  FuturePlanforClientDetails String?
  ClientFeelsHopless         Boolean
  ClientHoplessDetails       String? //Options
  ClientHopelessMultiple     String[]
  InterviewerOpinoin         String?
  InterviewerID              String
  InterviewerisGovernStaff   Boolean
  status                     Boolean              @default(true)
  InterViewDate              DateTime
  InterViewerSignature       String?
  governStaffID              String?
  StaffID                    String?
  serviceCenterID            String
  Staff                      Staff?               @relation(fields: [StaffID], references: [id])
  governStaff                governStaff?         @relation(fields: [governStaffID], references: [id])
  ServiceCenter              ServiceCenter        @relation(fields: [serviceCenterID], references: [id])
  ClientProgress             ClientProgress[]
  ClientServeHistory         ClientServeHistory[]
}

model ClientServeHistory {
  id                           String                      @id @unique @default(cuid())
  nameCenterorPrison           String?
  DateTimeServed               DateTime
  Client_PersonalInformationID String
  Client_PersonalInformation   Client_PersonalInformation? @relation(fields: [Client_PersonalInformationID], references: [id])
}

model ClientProgress {
  id                           String                      @id @unique @default(cuid())
  NoteDateTime                 DateTime
  Details                      String
  Client_PersonalInformationID String
  Client_PersonalInformation   Client_PersonalInformation? @relation(fields: [Client_PersonalInformationID], references: [id])
}
