node_modules
*.log*
.nuxt
.nitro
.cache
.output
# Every env file except the placeholder template. The old tracked "example env"
# held live production credentials — database, Firebase service account, SMTP
# and reCAPTCHA — in plaintext; all were rotated. Only .env.example belongs in
# git, and it must contain placeholders only.
.env
.env.*
!.env.example
example env
dist
package-lock.json
pnpm-lock.yaml

# Database dumps. These contain named clients' case records — including
# minors' substance-use, family and criminal-justice data. They must never
# be committed, and shouldn't be left lying around longer than needed.
backups/
*.dump
*.sql.gz
