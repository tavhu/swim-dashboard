node_modules
*.log*
.nuxt
.nitro
.cache
.output
# Every env file except the placeholder template. The old tracked "example env"
# held live production credentials in plaintext — database, Firebase service
# account, SMTP, reCAPTCHA, the GitHub OAuth secret and NUXT_SECRET.
#
# They have NOT all been rotated. Audited 2026-08-17: nine of the eleven values
# are still byte-identical to the ones in git history, and the reCAPTCHA secret
# and the Firebase service-account key were both confirmed still live against
# Google. The file is untracked from HEAD but history was left intact, so anyone
# who can clone the repository can still read them.
#
# Only .env.example belongs in git, and it must contain placeholders only.
.env
.env.*
!.env.example
example env
dist
package-lock.json
pnpm-lock.yaml

# Database dumps. These contain named clients' case records — including
# minors' substance-use, family and criminal-justice data. They must never
# be committed, and shouldn't be left lying around longer than needed.
backups/
*.dump
*.sql.gz
# Root-level .sql only — anchored so it cannot swallow
# prisma/migrations/*/migration.sql, which must stay tracked.
/*.sql

# Client uploads — photographs and scanned attachments belonging to real people.
# These are data, not source: they belong on the server's disk and in its backups,
# not in a repository that gets cloned onto laptops. 14 were committed before this
# rule existed and are still in history; removing those needs a history rewrite
# and a force-push, which is the repository owner's call.
public/uploads/*
!public/uploads/.gitkeep
