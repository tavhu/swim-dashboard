# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
#
# This file replaces the old tracked "example env", which held live production
# credentials in plaintext. Everything in it was rotated; keep it that way by
# putting only placeholders here.

# --- Auth -------------------------------------------------------------------
GITHUB_CLIENT_ID="YOUR_GITHUB_APPLICATION_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_APPLICATION_SECRET"
NUXT_SECRET="YOUR_NUXT_SECRET"
NUXT_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# --- TLS (production only) --------------------------------------------------
CERTBOT_DOMAIN="YOUR_DOMAIN"
CERTBOT_EMAIL="YOUR_ADMIN_EMAIL"

# --- Outbound mail ----------------------------------------------------------
EMAIL_USER="YOUR_SMTP_USER"
EMAIL_PASSWORD="YOUR_SMTP_PASSWORD"
EMAIL_HOST="YOUR_SMTP_HOST"

# --- reCAPTCHA --------------------------------------------------------------
# SERVER is the secret key and must stay private.
# CLIENT is the site key: it ships to the browser and is public by design.
RECAPTCHA_SERVER_SECRET_KEY="YOUR_RECAPTCHA_SECRET_KEY"
RECAPTCHA_CLIENT_SECRET_KEY="YOUR_RECAPTCHA_SITE_KEY"

# --- Firebase admin service account -----------------------------------------
# From the service-account JSON. Keep NUXT_FIREBASE_PRIVATE_KEY on one line with
# literal \n escapes, quoted, exactly as the JSON gives it.
NUXT_FIREBASE_TYPE="service_account"
NUXT_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
NUXT_FIREBASE_PRIVATE_KEY_ID="YOUR_PRIVATE_KEY_ID"
NUXT_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
NUXT_FIREBASE_CLIENT_EMAIL="YOUR_SERVICE_ACCOUNT_EMAIL"
NUXT_FIREBASE_CLIENT_ID="YOUR_CLIENT_ID"
NUXT_FIREBASE_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
NUXT_FIREBASE_TOKEN_URI="https://oauth2.googleapis.com/token"
NUXT_FIREBASE_AUTH_PROVIDER_CERT_URL="https://www.googleapis.com/oauth2/v1/certs"
NUXT_FIREBASE_CLIENT_CERT_URL="YOUR_CLIENT_CERT_URL"
NUXT_FIREBASE_UNIVERSE_DOMAIN="googleapis.com"

# --- Database ---------------------------------------------------------------
# SHADOW_DATABASE_URL is used by `prisma migrate dev` for a scratch database and
# must point somewhere disposable — never at production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_shadow?schema=public"
